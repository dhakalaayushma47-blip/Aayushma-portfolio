            <span className="tags">
              <span>Python</span>
              <span>AI</span>
              <span>Analytics</span>
              <span>Web</span>
            </span>
            <span className="project-open">EXPLORE PROJECT ↗</span>
          </span>
        </button>

        <button
          type="button"

        {/* SKILLS */}
        <section className="section skills" id="skills">
          <p className="section-label">04 — SKILLS</p>

          <div className="skills-grid">
            <div>
              <h3>Development</h3>
              <p>Python</p>
              <p>JavaScript</p>
              <p>React</p>
              <p>HTML / CSS</p>
              <p>SQL</p>
              <p>Git / GitHub</p>
